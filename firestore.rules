rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == "emiliojacobg@gmail.com" || request.auth.token.email.matches(".*@gmail\\.com"));
    }
  }
}
